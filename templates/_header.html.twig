{# Barre du haut des visiteurs non connectés (les connectés ont la sidebar : _sidebar.html.twig). #}
{% import '_ui.html.twig' as ui %}
{% set route = app.request.attributes.get('_route') %}

<header class="topbar">
    <div class="container topbar__inner">
        <a class="logo" href="{{ path('app_home') }}">
            <span class="logo__mark">{{ ui.icon('leaf', 20) }}</span>
            <span class="logo__text">Anti<span>-gaspi</span></span>
        </a>

        <div class="topbar__actions">
            <a class="btn btn--ghost btn--sm" href="{{ path('app_nearby') }}" title="Autour de moi">{{ ui.icon('map', 18) }}<span class="hide-sm">Autour de moi</span></a>
            <a class="btn btn--ghost btn--sm hide-sm" href="{{ path('app_commerce_register') }}">{{ ui.icon('store', 18) }} Inscrire mon commerce</a>
            {% if route != 'app_login' %}
                <a class="btn btn--primary btn--sm" href="{{ path('app_login') }}">Se connecter</a>
            {% else %}
                <a class="btn btn--primary btn--sm" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</header>
