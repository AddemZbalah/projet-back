{% import '_ui.html.twig' as ui %}
{% set route = app.request.attributes.get('_route') %}
{# Raccourcis mobiles ; le reste de la navigation est dans le tiroir (bouton « Menu »). #}
<nav class="bottomnav" aria-label="Navigation mobile">
    <a href="{{ path('app_home') }}" {% if route in ['app_home', 'app_offre_show'] %}aria-current="page"{% endif %}>
        {{ ui.icon('compass', 22) }}<span>Découvrir</span>
    </a>
    <a href="{{ path('app_nearby') }}" {% if route == 'app_nearby' %}aria-current="page"{% endif %}>
        {{ ui.icon('map', 22) }}<span>Carte</span>
    </a>
    <a href="{{ path('app_reservations') }}" {% if route in ['app_reservations', 'app_review_form'] %}aria-current="page"{% endif %}>
        {{ ui.icon('ticket', 22) }}<span>Réservations</span>
    </a>
    <a href="{{ path('app_favorites') }}" {% if route == 'app_favorites' %}aria-current="page"{% endif %}>
        {{ ui.icon('heart', 22) }}<span>Favoris</span>
    </a>
    <button type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        {{ ui.icon('menu', 22) }}<span>Menu</span>
    </button>
</nav>
