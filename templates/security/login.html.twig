{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth">
        <section class="auth__card">
            <header class="auth__head">
                <h1>Ravi de vous revoir</h1>
                <p>Connectez-vous pour réserver des paniers près de chez vous.</p>
            </header>

            {% if error %}
                <div class="alert alert--error" role="alert">{{ ui.icon('alert', 20) }}<span>{{ error.messageKey|trans(error.messageData, 'security') }}</span></div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert--success" role="status">
                    {{ ui.icon('check', 20) }}
                    <span>Vous êtes connecté avec {{ app.user.userIdentifier }}. <a href="{{ logout_path() }}">Se déconnecter</a></span>
                </div>
            {% endif %}

            <form method="post" class="form">
                <div class="field">
                    <label for="username">Adresse e-mail</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus>
                </div>

                <div class="field">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn--primary btn--lg btn--block" type="submit">Se connecter</button>
            </form>

            <p class="auth__foot">
                Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
            </p>
        </section>
    </div>
{% endblock %}
