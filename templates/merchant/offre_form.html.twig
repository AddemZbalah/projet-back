{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}{{ isNew ? 'Publier une offre' : 'Modifier l’offre' }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_merchant_dashboard') }}">{{ ui.icon('arrow-left', 18) }} Retour à mon espace</a>

    <div class="editor">
        <section class="card">
            <header class="auth__head">
                <h1>{{ isNew ? 'Publier une offre' : 'Modifier l’offre' }}</h1>
                <p>{{ isNew ? 'Vos clients la verront immédiatement sur l’accueil.' : 'Les clients ayant déjà réservé conservent leur réservation.' }}</p>
            </header>

            {{ form_start(form, { attr: { class: 'form', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}

                {% if form.commerce is defined %}{{ form_row(form.commerce) }}{% endif %}

                <fieldset class="fieldset">
                    <legend>Le panier</legend>
                    {{ form_row(form.title) }}
                    {{ form_row(form.description) }}
                </fieldset>

                <fieldset class="fieldset">
                    <legend>{{ form.preferences.vars.label }}</legend>
                    <p class="help" style="margin-top: -6px;">{{ form.preferences.vars.help }}</p>
                    <div class="choice-chips">
                        {% for child in form.preferences %}
                            <label class="choice-chip" for="{{ child.vars.id }}">
                                {{ form_widget(child) }}
                                <span>{{ ui.icon('check', 16) }} {{ child.vars.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    {% do form.preferences.setRendered %}
                </fieldset>

                {% if sourceImages|default([]) is not empty %}
                    <div class="republish-photos">
                        <p class="help">{{ ui.icon('check', 16) }} Les {{ sourceImages|length }} photo(s) de l’offre d’origine seront reprises :</p>
                        <ul class="photo-grid">
                            {% for image in sourceImages %}
                                <li class="photo-tile"><img src="{{ image.url }}" alt="Photo reprise {{ loop.index }}" loading="lazy"></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {{ include('_photo_dropzone.html.twig', {
                    field: form.photos,
                    images: isNew ? [] : offre.images,
                    help: 'Montrez le type de produits du panier. La première photo sert de couverture. Sans photo, celles du commerce sont utilisées.',
                }) }}

                <fieldset class="fieldset">
                    <legend>Prix et quantité</legend>
                    <div class="grid-3">
                        {{ form_row(form.originalPrice) }}
                        {{ form_row(form.discountedPrice) }}
                        {{ form_row(form.quantityTotal) }}
                    </div>
                    <p class="help" id="discount-preview" aria-live="polite"></p>
                </fieldset>

                <fieldset class="fieldset">
                    <legend>Créneau de retrait</legend>
                    <div class="grid-2">
                        {{ form_row(form.pickupStart) }}
                        {{ form_row(form.pickupEnd) }}
                    </div>
                </fieldset>

                <div class="form-actions">
                    <a class="btn btn--ghost" href="{{ path('app_merchant_dashboard') }}">Annuler</a>
                    <button class="btn btn--primary" type="submit">{{ isNew ? 'Mettre en ligne' : 'Enregistrer' }}</button>
                </div>
            {{ form_end(form) }}
        </section>

        <aside class="editor__tips">
            <div class="card">
                <h3>Conseils</h3>
                <ul class="tips">
                    <li>{{ ui.icon('check', 18) }} Une réduction d’au moins 50 % attire beaucoup plus de clients.</li>
                    <li>{{ ui.icon('check', 18) }} Décrivez le type de produits sans tout promettre : c’est un panier surprise.</li>
                    <li>{{ ui.icon('check', 18) }} Choisissez un créneau proche de votre fermeture, quand les invendus sont connus.</li>
                </ul>
            </div>
        </aside>
    </div>

    <script>
        (() => {
            const orig = document.getElementById('{{ form.originalPrice.vars.id }}');
            const sale = document.getElementById('{{ form.discountedPrice.vars.id }}');
            const out = document.getElementById('discount-preview');
            const update = () => {
                const o = parseFloat(orig.value), s = parseFloat(sale.value);
                out.textContent = (o > 0 && s > 0 && s < o)
                    ? `Réduction affichée aux clients : -${Math.round((1 - s / o) * 100)} %`
                    : '';
            };
            orig.addEventListener('input', update);
            sale.addEventListener('input', update);
            update();
        })();
    </script>
{% endblock %}
