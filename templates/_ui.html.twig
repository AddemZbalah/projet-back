{# Icône + teinte associées à la catégorie d'un commerce. #}
{% macro category_theme(category) %}
    {%- set c = category|default('')|lower -%}
    {%- if 'boulang' in c or 'pâtiss' in c or 'patiss' in c -%}wheat|amber
    {%- elseif 'sushi' in c or 'japon' in c or 'poisson' in c -%}fish|rose
    {%- elseif 'fast' in c or 'sandwich' in c or 'kebab' in c or 'restau' in c or 'traiteur' in c -%}utensils|sky
    {%- else -%}bag|green
    {%- endif -%}
{% endmacro %}

{% macro pickup_day(date) %}
    {%- set d = date|date('Y-m-d') -%}
    {%- if d == 'now'|date('Y-m-d') -%}Aujourd’hui
    {%- elseif d == '+1 day'|date('Y-m-d') -%}Demain
    {%- else -%}Le {{ date|date('d/m') }}
    {%- endif -%}
{% endmacro %}

{% macro discount(offre) %}
    {%- if offre.originalPrice > 0 -%}
        {{- ((1 - offre.discountedPrice / offre.originalPrice) * 100)|round -}}
    {%- else -%}0{%- endif -%}
{% endmacro %}

{% macro price(value) %}{{ value|number_format(2, ',', ' ') }} €{% endmacro %}

{# 5 étoiles, pleines jusqu'à la note arrondie. #}
{% macro stars(rating, size = 16) %}
    {%- import _self as ui -%}
    <span class="stars" role="img" aria-label="{{ rating|number_format(1, ',') }} sur 5">
        {%- for i in 1..5 -%}
            <span class="{{ i <= rating|round ? 'is-on' : '' }}">{{ ui.icon('star', size) }}</span>
        {%- endfor -%}
    </span>
{% endmacro %}

{# Note moyenne compacte : ★ 4,5 (12) — rien si aucun avis. #}
{% macro rating_badge(commerce) %}
    {%- import _self as ui -%}
    {%- if commerce.averageRating is not null -%}
        <span class="rating-badge" title="Note moyenne sur {{ commerce.reviews|length }} avis">
            {{ ui.icon('star', 14) }} {{ commerce.averageRating|number_format(1, ',') }} <span class="muted">({{ commerce.reviews|length }})</span>
        </span>
    {%- endif -%}
{% endmacro %}

{# « il y a 3 jours », « il y a 2 mois »… #}
{% macro time_ago(date) %}
    {%- set s = 'now'|date('U') - date|date('U') -%}
    {%- set d = (s / 86400)|round(0, 'floor') -%}
    {%- if s < 3600 -%}il y a quelques minutes
    {%- elseif d < 1 -%}il y a {{ (s / 3600)|round(0, 'floor') }} h
    {%- elseif d < 2 -%}hier
    {%- elseif d < 7 -%}il y a {{ d }} jours
    {%- elseif d < 30 -%}il y a {{ (d / 7)|round(0, 'floor') }} semaine{{ d >= 14 ? 's' : '' }}
    {%- elseif d < 365 -%}il y a {{ (d / 30)|round(0, 'floor') }} mois
    {%- else -%}il y a {{ (d / 365)|round(0, 'floor') }} an{{ d >= 730 ? 's' : '' }}
    {%- endif -%}
{% endmacro %}

{% macro pref_tags(offre) %}
    {%- if offre.preferences is not empty -%}
        <span class="pref-tags">
            {%- for p in offre.preferences -%}<span class="pref-tag">{{ p.name|capitalize }}</span>{%- endfor -%}
        </span>
    {%- endif -%}
{% endmacro %}
