{% import '_ui.html.twig' as ui %}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert--{{ type == 'error' ? 'error' : 'success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
            {{ ui.icon(type == 'error' ? 'alert' : 'check', 20) }}
            <span>{{ message }}</span>
        </div>
    {% endfor %}
{% endfor %}
