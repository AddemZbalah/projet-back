{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}Avis sur {{ commerce.name }}{% endblock %}
{% block main_class %}page--narrow{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_reservations') }}">{{ ui.icon('arrow-left', 18) }} Retour à mes réservations</a>

    <section class="card">
        <header class="auth__head">
            <p class="eyebrow" style="margin: 0 0 10px;">{{ ui.icon('star', 16) }} {{ isNew ? 'Votre avis' : 'Modifier votre avis' }}</p>
            <h1>{{ commerce.name }}</h1>
            <p>Votre retour aide les autres clients… et le commerçant à s’améliorer.</p>
        </header>

        {{ form_start(form, { attr: { class: 'form' } }) }}
            <fieldset class="fieldset">
                <legend>{{ form.rating.vars.label }}</legend>
                <div class="rating-input" role="radiogroup" aria-label="Note de 1 à 5">
                    {# Ordre inversé + flex-direction: row-reverse : le survol colore l'étoile et toutes celles à sa gauche. #}
                    {% for child in form.rating.children|reverse %}
                        {{ form_widget(child, { attr: { class: 'rating-input__radio' } }) }}
                        <label for="{{ child.vars.id }}" title="{{ child.vars.label }}">{{ ui.icon('star', 34) }}<span class="sr-only">{{ child.vars.label }}</span></label>
                    {% endfor %}
                </div>
                {{ form_errors(form.rating) }}
            </fieldset>

            {{ form_row(form.comment) }}

            <div class="form-actions">
                <a class="btn btn--ghost" href="{{ path('app_reservations') }}">Annuler</a>
                <button class="btn btn--primary" type="submit">{{ isNew ? 'Publier mon avis' : 'Enregistrer' }}</button>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
