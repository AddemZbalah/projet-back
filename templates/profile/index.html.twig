{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>Mon profil</h1>
        <p>Gérez vos informations de connexion.</p>
    </header>

    <div class="profile">
        <section class="card identity">
            <div class="avatar" aria-hidden="true">{{ user.mail|slice(0, 1)|upper }}</div>
            <h2>{{ user.mail }}</h2>
            <span class="chip">{{ is_granted('ROLE_MERCHANT') ? 'Compte commerçant' : 'Compte client' }}</span>

            <div class="stats">
                <div><span>Membre depuis</span><strong>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</strong></div>
                <div><span>Paniers sauvés</span><strong>{{ user.reservations|filter(r => r.status.value == 'collected')|length }}</strong></div>
                <div><span>Avis publiés</span><strong>{{ user.reviews|length }}</strong></div>
            </div>

            <nav class="quick-links" aria-label="Raccourcis">
                <a href="{{ path('app_reservations') }}">{{ ui.icon('ticket', 18) }} Mes réservations</a>
                <a href="{{ path('app_favorites') }}">{{ ui.icon('heart', 18) }} Mes favoris <span class="muted">{{ user.favorites|length }}</span></a>
                <a href="{{ path('app_notifications') }}">{{ ui.icon('bell', 18) }} Notifications {% if user.unreadNotificationsCount > 0 %}<span class="count">{{ user.unreadNotificationsCount }}</span>{% endif %}</a>
            </nav>
        </section>

        <div class="profile__main">
        <section class="card" id="preferences" aria-labelledby="pref-title">
            <h2 id="pref-title">Mes préférences alimentaires</h2>
            <p class="help" style="margin: 6px 0 16px;">Les paniers compatibles avec toutes vos préférences sont mis en avant sur l’accueil.</p>
            <form method="post" action="{{ path('app_profile_preferences') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('preferences') }}">
                <div class="choice-chips">
                    {% for p in preferences %}
                        <label class="choice-chip">
                            <input type="checkbox" name="preferences[]" value="{{ p.id }}" {% if p in user.preferences %}checked{% endif %}>
                            <span>{{ ui.icon('check', 16) }} {{ p.name|capitalize }}</span>
                        </label>
                    {% endfor %}
                </div>
                <button class="btn btn--soft" type="submit" style="margin-top: 18px;">Enregistrer mes préférences</button>
            </form>
        </section>

        <section class="card">
            {% for error in errors %}
                <div class="alert alert--error" role="alert">{{ ui.icon('alert', 20) }}<span>{{ error }}</span></div>
            {% endfor %}

            {% if updated %}
                <div class="alert alert--success" role="status">{{ ui.icon('check', 20) }}<span>Vos informations ont bien été mises à jour.</span></div>
            {% endif %}

            <form method="post" class="form">
                <input type="hidden" name="_token" value="{{ csrf_token('profile') }}">

                <h2 style="margin-top: 0;">Informations</h2>
                <div class="field">
                    <label for="mail">Adresse e-mail</label>
                    <input type="email" id="mail" name="mail" value="{{ mail }}" autocomplete="email" required>
                </div>

                <hr class="form-divider">

                <div>
                    <h2>Mot de passe</h2>
                    <p class="help">Laissez ces champs vides pour conserver votre mot de passe actuel.</p>
                </div>

                <div class="field">
                    <label for="password">Nouveau mot de passe</label>
                    <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" aria-describedby="password-help">
                    <span class="help" id="password-help">8 caractères minimum.</span>
                </div>

                <div class="field">
                    <label for="password_confirmation">Confirmer le nouveau mot de passe</label>
                    <input type="password" id="password_confirmation" name="password_confirmation" minlength="8" autocomplete="new-password">
                </div>

                <div><button class="btn btn--primary" type="submit">Enregistrer les modifications</button></div>
            </form>
        </section>
        </div>
    </div>
{% endblock %}
