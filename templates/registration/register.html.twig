{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
    <div class="auth">
        <section class="auth__card">
            <header class="auth__head">
                <h1>Créer un compte</h1>
                <p>Rejoignez-nous pour sauver les invendus des commerces près de chez vous.</p>
            </header>

            {% for error in errors %}
                <div class="alert alert--error" role="alert">{{ ui.icon('alert', 20) }}<span>{{ error }}</span></div>
            {% endfor %}

            <form method="post" class="form">
                <input type="hidden" name="_token" value="{{ csrf_token('register') }}">

                <div class="field">
                    <label for="mail">Adresse e-mail</label>
                    <input type="email" id="mail" name="mail" value="{{ mail }}" autocomplete="email" required autofocus>
                </div>

                <div class="field">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" aria-describedby="pwd-help" required>
                    <span class="help" id="pwd-help">8 caractères minimum.</span>
                </div>

                <div class="field">
                    <label for="password_confirmation">Confirmer le mot de passe</label>
                    <input type="password" id="password_confirmation" name="password_confirmation" minlength="8" autocomplete="new-password" required>
                </div>

                {{ include('legal/_cgu_checkbox.html.twig') }}

                <button class="btn btn--primary btn--lg btn--block" type="submit">Créer mon compte</button>
            </form>

            <p class="auth__foot">
                Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </section>
    </div>
{% endblock %}
